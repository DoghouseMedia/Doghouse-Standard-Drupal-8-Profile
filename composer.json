{
    "name": "doghouse/doghouse-standard-profile",
    "description": "Doghouse standard profile",
    "type": "drupal-profile",
    "license": "GPL-2.0+",
    "authors": [
        {
            "name": "Doghouse Agency",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "1.*",
        "drupal/admin_toolbar": "^3.6",
        "drupal/config_ignore": "^3.4",
        "drupal/config_readonly": "^1.0",
        "drupal/config_split": "^2.0@RC",
        "drupal/config_update": "^2.0@alpha",
        "drupal/context": "^5.0@RC",
        "drupal/core": "^10.3 || ^11",
        "drupal/core-composer-scaffold": "^10.3 || ^11",
        "drupal/custom_markup_block": "^1.3",
        "drupal/dropzonejs": "^2.11",
        "drupal/ds": "^3.37",
        "drupal/entity": "^1.5",
        "drupal/entity_browser": "^2.15",
        "drupal/entity_embed": "^1.7",
        "drupal/features": "^3.16",
        "drupal/field_group": "^4.0",
        "drupal/google_tag": "^2.0",
        "drupal/inline_entity_form": "^3.0",
        "drupal/media_entity_browser": "^3.0",
        "drupal/metatag": "^2.2",
        "drupal/paragraphs": "^1.20",
        "drupal/pathauto": "^1.15",
        "drupal/rabbit_hole": "^1.2",
        "drupal/redirect": "^1.13",
        "drupal/styleguide": "^2.2",
        "drupal/token": "^1.17",
        "drupal/views_block_filter_block": "^2.0",
        "drupal/webform": "^6.3@RC",
        "drupal/xmlsitemap": "^2.0"
    },
    "require-dev": {
        "drupal/devel": "^5.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "process-timeout": 0,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true
        }
    },
    "extra": {
        "installer-paths": {
            "docroot/core": ["type:drupal-core"],
            "docroot/libraries/{$name}": ["type:drupal-library"],
            "docroot/modules/contrib/{$name}": ["type:drupal-module"],
            "docroot/profiles/contrib/{$name}": ["type:drupal-profile"],
            "docroot/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/contrib/{$name}": ["type:drupal-drush"]
        },
        "patches": {
            "drupal/entity_browser": {
                "Fix call to a member function getConfigDependencyKey() on null": "https://www.drupal.org/files/issues/2845037-4.patch"
            }
        },
        "enable-patching": true
    }
}
